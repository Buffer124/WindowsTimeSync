<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    
    <AssemblyName>WindowsTimeSync</AssemblyName>
    <RootNamespace>WindowsTimeSync</RootNamespace>

    <Version>2.0.0.0</Version>
    <FileVersion>2.0.0.0</FileVersion>
    <AssemblyTitle>Windows Time Synchronization Tool</AssemblyTitle>
    <Product>Windows Time Sync</Product>
    <Company>Minh Duy Utility</Company>

    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UseWindowsForms>false</UseWindowsForms>

    <!-- Xuất bản 32-bit Single-File tương thích toàn diện cả x86 và x64 -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <PublishReadyToRun>false</PublishReadyToRun>
    
    <!-- Cơ chế nén Single-File an toàn chuẩn Microsoft -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>

    <!-- Tước bỏ PDB và symbols để giảm dung lượng và chống dịch ngược -->
    <StripSymbols>true</StripSymbols>
    <DebugSymbols>false</DebugSymbols>
    <DebugType>none</DebugType>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EventSourceSupport>false</EventSourceSupport>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <StackTraceSupport>false</StackTraceSupport>

    <NoWarn>$(NoWarn);CS8500</NoWarn>
  </PropertyGroup>

</Project>